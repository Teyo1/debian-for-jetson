# --- jetson-debian build configuration ---
DEBIAN_SUITE=trixie
DEBIAN_MIRROR=http://deb.debian.org/debian
L4T_REPO_REL=r39.2                 # NVIDIA apt suite (matches the board's firmware generation)
ROOTFS=${ROOTFS:-/srv/debian-trixie}   # where the Debian tree is built (override: ROOTFS=/srv/x ./build-all.sh)
NEW_HOSTNAME=jetson
NEW_USER=jetson
NEW_PASSWORD=changeme              # forced to change at first login
LOCALE=en_US.UTF-8
# Set to the kernel version shipped by nvidia-l4t-kernel (auto-detected if empty)
KERNEL_VER=

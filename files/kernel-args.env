# Kernel arguments taken from NVIDIA's own installer (jetsoninstaller r39.2.1 grub.cfg).
# clk_ignore_unused/pd_ignore_unused keep clocks and power domains (USB, display) alive during early boot.
KARGS_COMMON="clk_ignore_unused pd_ignore_unused firmware_class.path=/etc/firmware fbcon=map:0 nospectre_bhb efi=runtime mminit_loglevel=4 console=tty0"

PALETTES = {
    "light": dict(bg="#f4f5f2", card="#ffffff", line="#d9dcd3", text="#1d2417", hint="#6b7360", edge="#b8bdb0",
                  btn="#e6e9e0", trough="#dfe3d6", offg="#b9c3a8", offr="#d9b1ae", badc="#b3261e"),
    "dark": dict(bg="#14170f", card="#1f241a", line="#333a2c", text="#e8ecdf", hint="#9aa28d", edge="#4a5240",
                 btn="#2c3325", trough="#2c3325", offg="#3a4a24", offr="#5a2b28", badc="#ff8a80"),
}


def palette_css(name):
    defs = "".join(f"@define-color {k} {v};\n" for k, v in PALETTES[name].items())
    return (defs + CSS).encode()


def countries():
    """[(name, code)] sorted by name, and {code: [(time zone, comment)]} from the tz database."""
    names, zones = {}, {}
    try:
        for line in open("/usr/share/zoneinfo/iso3166.tab"):
            if not line.startswith("#") and "\t" in line:
                cc, name = line.rstrip("\n").split("\t", 1); names[cc] = name
        for line in open("/usr/share/zoneinfo/zone.tab"):
            if line.startswith("#"):
                continue
            p = line.rstrip("\n").split("\t")
            if len(p) >= 3:
                zones.setdefault(p[0], []).append((p[2], p[3] if len(p) > 3 else ""))
    except OSError:
        pass
    lst = sorted((names.get(cc, cc), cc) for cc in zones)
    lst.append(("UTC (no country)", "--")); zones["--"] = [("UTC", "")]
    return lst, zones


def layouts():
    out, on = [], False
    try:
        for line in open("/usr/share/X11/xkb/rules/base.lst"):
            if line.startswith("! "):
                on = line.strip() == "! layout"
                continue
            if on and line.strip():
                code, _, desc = line.strip().partition(" ")
                out.append((desc.strip(), code))
    except OSError:
        pass
    return sorted(out)


def drives():
    """NVMe drives we may install to: every one except the disk this system runs from."""
    if FAKE:
        return [("/dev/nvme0n1", "953.9G  Samsung SSD 980 PRO (example)"), ("/dev/nvme1n1", "238.5G  WD Blue SN570 (example)")][:int(os.environ.get("FAKE_DRIVES", "1"))]
    try:
        src = subprocess.check_output(["findmnt", "-n", "-o", "SOURCE", "/"], text=True).strip()
        rootdisk = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True, text=True).stdout.split("\n")[0].strip()
    except Exception:
        rootdisk = ""
    res = []
    for n in sorted(os.listdir("/dev")):
        if re.fullmatch(r"nvme[0-9]+n1", n) and n != rootdisk:
            info = subprocess.run(["lsblk", "-dno", "SIZE,MODEL", "/dev/" + n], capture_output=True, text=True).stdout.strip()
            res.append(("/dev/" + n, info))
    return res


def label(text, css=None, wrap=True):
    l = Gtk.Label(label=text, xalign=0)
    l.set_line_wrap(wrap)
    if css:
        l.get_style_context().add_class(css)
    return l


def field(grid, row, text, widget):
    l = Gtk.Label(label=text, xalign=0)
    grid.attach(l, 0, row, 1, 1)
    widget.set_hexpand(True)
    grid.attach(widget, 1, row, 1, 1)


class Wizard(Gtk.Window):
    def __init__(self):
        super().__init__(title="Install Debian on the Jetson")
        self.drive_list = drives()
        self.countries, self.zones = countries()
        self.layouts = layouts()
        self.process = None
        self.finished = False
        self.notes = []
        self.rc = 0

        scr = Gdk.Screen.get_default()
        if not WINDOWED and scr.get_height() > 1300:   # big/high-resolution monitors: scale everything up
            Gtk.Settings.get_default().set_property("gtk-xft-dpi", int(96 * scr.get_height() / 1080 * 1024))
        self.css = Gtk.CssProvider(); self.dark = True; self.css.load_from_data(palette_css("dark"))
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card.get_style_context().add_class("card")
        card.set_size_request(640, -1)
        card.set_halign(Gtk.Align.CENTER); card.set_valign(Gtk.Align.CENTER)
        ov = Gtk.Overlay(); ov.add(card); self.add(ov)
        tb = Gtk.Box(spacing=10); tb.set_halign(Gtk.Align.END); tb.set_valign(Gtk.Align.START)
        tb.set_margin_top(18); tb.set_margin_end(24)
        self.mode = Gtk.Switch(); self.mode.set_active(True); self.mode.set_valign(Gtk.Align.CENTER)
        tb.pack_start(Gtk.Label(label="Dark mode"), False, False, 0); tb.pack_start(self.mode, False, False, 0)
        self.mode.connect("notify::active", self.on_mode); ov.add_overlay(tb)

        self.title = label("", "title"); card.pack_start(self.title, False, False, 0)
        self.stepl = label("", "step"); card.pack_start(self.stepl, False, False, 0)
        self.stack = Gtk.Stack(); self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
        card.pack_start(self.stack, True, True, 6)
        self.nav = Gtk.Box(spacing=10); card.pack_end(self.nav, False, False, 0)
        self.back = Gtk.Button(label="Back"); self.next = Gtk.Button(label="Next")
        self.next.get_style_context().add_class("suggested-action")
        self.back.connect("clicked", lambda *_: self.go(-1)); self.next.connect("clicked", lambda *_: self.on_next())
        self.nav.pack_end(self.next, False, False, 0); self.nav.pack_end(self.back, False, False, 0)

        self.pages = []   # (name, title, widget)
        self.build_welcome(); self.build_drive(); self.build_region(); self.build_account(); self.build_options(); self.build_confirm()
        self.build_progress(); self.build_done()
        self.idx = 0
        self.show_page()

        if WINDOWED:
            self.set_default_size(900, 700)
        else:
            # No window manager is needed: cover the whole monitor ourselves; the card is centred inside.
            mon = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
            g = mon.get_geometry()
            self.set_decorated(False); self.set_size_request(g.width, g.height); self.set_default_size(g.width, g.height)
            self.move(g.x, g.y); self.fullscreen()   # fullscreen needs a window manager; the size request covers the case without one
        self.connect("delete-event", self.on_close)
        self.connect("realize", lambda w: w.get_window().set_cursor(Gdk.Cursor.new_from_name(w.get_display(), "default")))
        if os.environ.get("JETSON_GUI_DEBUG"):
            self.connect("size-allocate", lambda w, a: print("window alloc", a.width, a.height, "pos", w.get_position(), "card", card.get_allocation().x, card.get_allocation().y, card.get_allocation().width, card.get_allocation().height, flush=True))

    def on_mode(self, b, _p=None):
        self.dark = b.get_active(); self.css.load_from_data(palette_css("dark" if self.dark else "light"))

    # ---------- pages ----------
    def add_page(self, name, title, widget):
        self.stack.add_named(widget, name); self.pages.append((name, title))

    def vbox(self):
        return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

    def build_welcome(self):
        b = self.vbox()
        b.pack_start(label("This installs Debian 13 with the NVIDIA Jetson kernel, GPU driver and CUDA runtime onto the "
                           "NVMe drive of your Jetson Orin Nano."), False, False, 0)
        b.pack_start(label("You will choose the account, the name of the computer, your location and your keyboard. "
                           "Nothing is changed on the drive until you confirm on the last page.", "hint"), False, False, 0)
        if not self.drive_list:
            b.pack_start(label("No NVMe drive was found. Check that the drive is seated in the M.2 slot, then restart "
                               "the Jetson from the USB stick.", "bad"), False, False, 0)
        self.add_page("welcome", "Welcome", b)

    def build_drive(self):
        b = self.vbox()
        b.pack_start(label("Choose the drive to install to. Everything on it will be erased."), False, False, 0)
        self.c_drive = Gtk.ComboBoxText()
        for dev, info in self.drive_list:
            self.c_drive.append_text(f"{dev}    {info}")
        self.c_drive.connect("changed", lambda *_: self.refresh())   # with several drives none is pre-selected
        b.pack_start(self.c_drive, False, False, 0)
        self.multi = len(self.drive_list) > 1
        self.add_page("drive", "Drive", b)

    def build_account(self):
        b = self.vbox()
        g = Gtk.Grid(column_spacing=14, row_spacing=10); b.pack_start(g, False, False, 0)
        self.e_user = Gtk.Entry(); self.e_pw1 = Gtk.Entry(); self.e_pw2 = Gtk.Entry(); self.e_host = Gtk.Entry()
        for e in (self.e_pw1, self.e_pw2):
            e.set_visibility(False)
        field(g, 0, "Username", self.e_user); field(g, 1, "Password", self.e_pw1)
        field(g, 2, "Repeat the password", self.e_pw2); field(g, 3, "Name of this computer", self.e_host)
        for e in (self.e_user, self.e_pw1, self.e_pw2, self.e_host):
            e.connect("changed", lambda *_: self.refresh())
        chain = [self.e_user, self.e_pw1, self.e_pw2, self.e_host]
        for i, e in enumerate(chain):
            e.connect("activate", (lambda n: lambda *_: chain[n].grab_focus())(i + 1) if i < 3 else (lambda *_: self.next.clicked() if self.next.get_sensitive() else None))
        self.acc_msg = label("", "bad"); b.pack_start(self.acc_msg, False, False, 0)
        b.pack_start(label("The username is lower case letters, digits, - and _. The password needs at least 8 characters. "
                           "This account can use sudo.", "hint"), False, False, 0)
        self.add_page("account", "Who are you?", b)

    def build_region(self):
        b = self.vbox()
        b.pack_start(label("Where are you? Search for your country and click it. This sets the clock."), False, False, 0)
        self.search = Gtk.SearchEntry(); self.search.set_placeholder_text("Search for your country")
        b.pack_start(self.search, False, False, 0)
        self.cstore = Gtk.ListStore(str, str)
        for name, cc in self.countries:
            self.cstore.append([name, cc])
        self.cfilter = self.cstore.filter_new()
        self.cfilter.set_visible_func(lambda m, it, *_: self.search.get_text().lower() in m[it][0].lower())
        self.search.connect("search-changed", lambda *_: self.cfilter.refilter())
        self.ctree = Gtk.TreeView(model=self.cfilter); self.ctree.set_headers_visible(False)
        self.ctree.append_column(Gtk.TreeViewColumn("Country", Gtk.CellRendererText(), text=0))
        self.ctree.get_selection().connect("changed", self.on_country)
        sw = Gtk.ScrolledWindow(); sw.set_min_content_height(190); sw.add(self.ctree)
        b.pack_start(sw, True, True, 0)
        g = Gtk.Grid(column_spacing=14, row_spacing=10); b.pack_start(g, False, False, 0)
        self.c_zone = Gtk.ComboBoxText(); self.c_zone.connect("changed", lambda *_: self.refresh())
        self.zone_label = Gtk.Label(label="Time zone", xalign=0); g.attach(self.zone_label, 0, 0, 1, 1)
        self.c_zone.set_hexpand(True); g.attach(self.c_zone, 1, 0, 1, 1)
        self.c_kb = Gtk.ComboBoxText()
        for desc, code in self.layouts:
            self.c_kb.append_text(f"{desc}  [{code}]")
        self.c_kb.set_active(next((i for i, (_, c) in enumerate(self.layouts) if c == "us"), -1))   # the stock layout
        self.c_kb.connect("changed", self.on_kb)
        field(g, 1, "Keyboard layout", self.c_kb)
        self.kbtest = Gtk.Entry(); self.kbtest.set_placeholder_text("type here to see how the chosen layout types")
        field(g, 2, "Try your keyboard", self.kbtest)
        self.add_page("region", "Where are you?", b)
        self.zone_ids = []
        for w in (self.zone_label, self.c_zone):
            w.set_no_show_all(True); w.hide()

    def build_options(self):
        b = self.vbox()
        self.c_ssh = Gtk.CheckButton(label="Allow remote login over the network (SSH)")
        b.pack_start(self.c_ssh, False, False, 0)
        b.pack_start(label("Off is the safer choice. Tick it if you want to reach this Jetson from another computer.", "hint"), False, False, 0)
        b.pack_start(Gtk.Separator(), False, False, 6)
        b.pack_start(label("NVIDIA developer tools"), False, False, 0)
        b.pack_start(label("Downloaded from NVIDIA during the install. You can also add them later with apt.", "hint"), False, False, 0)
        self.c_dev = {}
        for key, text in (("cuda", "CUDA compiler and libraries (nvcc)   about 3.3 GB"), ("cudnn", "cuDNN   about 0.4 GB"),
                          ("tensorrt", "TensorRT   about 4.5 GB")):
            c = Gtk.CheckButton(label=text); c.connect("toggled", lambda *_: self.refresh()); b.pack_start(c, False, False, 0)
            self.c_dev[key] = c
        self.net = label("Checking the internet connection...", "hint"); b.pack_start(self.net, False, False, 0)
        threading.Thread(target=self.check_net, daemon=True).start()
        self.add_page("options", "Options", b)

    def check_net(self):
        ok = FAKE or subprocess.run(["curl", "-fsI", "--max-time", "6", "https://repo.download.nvidia.com/jetson/common/dists/r39.2/InRelease"],
                                    capture_output=True).returncode == 0
        self.online = ok
        GLib.idle_add(lambda: (self.net.set_text("Internet: connected." if ok else
                               "No internet connection found. Developer tools cannot be downloaded now; "
                               "you can add them later with apt."), False)[1])

    def devtools(self):
        return [k for k, c in self.c_dev.items() if c.get_active()]

    def build_confirm(self):
        b = self.vbox()
        self.summary = Gtk.Grid(column_spacing=18, row_spacing=6); b.pack_start(self.summary, False, False, 0)
        self.warn = label("The drive will be erased completely.", "bad"); b.pack_start(self.warn, False, False, 0)
        self.sure = Gtk.CheckButton(label="I understand that everything on the drive will be erased.")
        self.sure.connect("toggled", lambda *_: self.refresh())
        b.pack_start(self.sure, False, False, 6)
        self.add_page("confirm", "Ready to install", b)

    def build_progress(self):
        b = self.vbox()
        self.pstep = label("Starting...")
        self.bar = Gtk.ProgressBar(); b.pack_start(self.pstep, False, False, 0); b.pack_start(self.bar, False, False, 0)
        b.pack_start(label("This takes about ten minutes. Do not switch the Jetson off.", "hint"), False, False, 0)
        ex = Gtk.Expander(label="Details"); sw = Gtk.ScrolledWindow(); sw.set_min_content_height(170)
        self.log = Gtk.TextView(); self.log.set_editable(False); self.log.set_monospace(True); sw.add(self.log); ex.add(sw)
        b.pack_start(ex, True, True, 0)
        self.add_page("progress", "Installing", b)

    def build_done(self):
        b = self.vbox()
        self.done_msg = label(""); b.pack_start(self.done_msg, False, False, 0)
        self.add_page("done", "Done", b)

    # ---------- behaviour ----------
    def visible(self, name):
        if name == "drive":
            return self.multi
        return True

    def go(self, d):
        i = self.idx
        while True:
            i += d
            if 0 <= i < len(self.pages) and self.visible(self.pages[i][0]):
                break
            if not 0 <= i < len(self.pages):
                return
        self.idx = i; self.show_page()

    def show_page(self):
        name, title = self.pages[self.idx]
        self.title.set_text(title); self.stack.set_visible_child_name(name)
        shown = [p for p in self.pages if self.visible(p[0]) and p[0] not in ("progress", "done")]
        names = [p[0] for p in shown]
        self.stepl.set_text(f"Step {names.index(name)+1} of {len(names)}" if name in names else "")
        self.back.set_visible(name not in ("welcome", "progress", "done"))
        self.next.set_visible(name != "progress")
        sc = self.next.get_style_context()
        for c in ("suggested-action", "destructive-action"):
            sc.remove_class(c)
        if name == "confirm":
            sc.add_class("destructive-action"); self.next.set_label("Erase and install")
            self.fill_summary()
        elif name == "done":
            sc.add_class("suggested-action"); self.next.set_label("Restart")
        elif name == "welcome":
            sc.add_class("suggested-action"); self.next.set_label("Start")
        else:
            sc.add_class("suggested-action"); self.next.set_label("Next")
        self.refresh()
        self.show_all()
        GLib.idle_add(lambda: (self.queue_resize(), self.queue_draw(), False)[2])
        self.back.set_visible(name not in ("welcome", "progress", "done"))
        self.next.set_visible(name != "progress")

    def target(self):
        if not self.drive_list:
            return None
        if not self.multi:
            return self.drive_list[0]
        i = self.c_drive.get_active()
        return self.drive_list[i] if i >= 0 else None

    def region_ok(self):
        return bool(self.tz() and self.kb_code())

    def tz(self):
        i = self.c_zone.get_active()
        return self.zone_ids[i] if getattr(self, "zone_ids", None) and i >= 0 else None

    def kb_code(self):
        m = re.search(r"\[([a-z0-9_]+)\]$", (self.c_kb.get_active_text() or "").strip())
        if not m:
            return None
        return m.group(1) if any(c == m.group(1) for _, c in self.layouts) else None

    def account_error(self):
        u, p1, p2, h = (self.e_user.get_text(), self.e_pw1.get_text(), self.e_pw2.get_text(), self.e_host.get_text())
        if not u and not p1 and not p2 and not h:
            return ""
        if u and not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", u):
            return "The username must start with a letter and use only lower case letters, digits, - and _."
        if u in ("root", "daemon", "bin", "sys", "sync", "games", "man", "lp", "mail", "news", "uucp", "proxy", "www-data",
                 "backup", "list", "irc", "nobody", "messagebus", "sshd", "systemd-network"):
            return "That name is already used by the system."
        if h and not re.fullmatch(r"[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?", h):
            return "The computer name may contain letters, digits and - only."
        if p1 and len(p1) < 8:
            return "The password needs at least 8 characters."
        if p2 and p1 != p2:
            return "The two passwords are different."
        return ""

    def account_ok(self):
        return bool(self.e_user.get_text() and self.e_host.get_text() and self.e_pw1.get_text() and not self.account_error()
                    and self.e_pw1.get_text() == self.e_pw2.get_text() and len(self.e_pw1.get_text()) >= 8)

    def refresh(self):
        name = self.pages[self.idx][0]
        ok = True
        if name == "welcome":
            ok = bool(self.drive_list)
        elif name == "drive":
            ok = self.target() is not None
        elif name == "account":
            self.acc_msg.set_text(self.account_error()); ok = self.account_ok()
        elif name == "region":
            ok = self.region_ok()
        elif name == "confirm":
            ok = self.sure.get_active()
        self.next.set_sensitive(ok)

    def on_country(self, sel):
        model, it = sel.get_selected()
        self.c_zone.remove_all(); self.zone_ids = []
        if it is None:
            self.zone_label.hide(); self.c_zone.hide(); self.refresh(); return
        cc = model[it][1]
        for tz, note in self.zones.get(cc, []):
            self.c_zone.append_text(tz.split("/", 1)[-1].replace("_", " ") + (f"  -  {note}" if note else "")); self.zone_ids.append(tz)
        self.c_zone.set_active(0)
        many = len(self.zone_ids) > 1
        for w in (self.zone_label, self.c_zone):
            w.show() if many else w.hide()
        # the keyboard follows the country (Sweden -> Swedish); the person can still change it
        want = "gb" if cc == "GB" else cc.lower()
        i = next((n for n, (_, c) in enumerate(self.layouts) if c == want), None)
        if i is not None:
            self.c_kb.set_active(i)
        self.refresh()

    def on_kb(self, *_):
        code = self.kb_code()
        if code and not FAKE:
            subprocess.Popen(["setxkbmap", code], stderr=subprocess.DEVNULL)
        self.refresh()

    def fill_summary(self):
        for c in self.summary.get_children():
            self.summary.remove(c)
        d = self.target()
        tz = self.tz()
        rows = [("Drive", f"{d[0]}  {d[1]}"), ("Username", self.e_user.get_text()), ("Computer name", self.e_host.get_text()),
                ("Time zone", tz), ("Keyboard", (self.c_kb.get_active_text() or "")),
                ("Remote login (SSH)", "on" if self.c_ssh.get_active() else "off"),
                ("Developer tools", ", ".join(self.devtools()) or "none")]
        for i, (k, v) in enumerate(rows):
            a = label(k, "hint"); b = label(v); b.set_selectable(False)
            self.summary.attach(a, 0, i, 1, 1); self.summary.attach(b, 1, i, 1, 1)
        self.summary.show_all()

    def on_next(self):
        name = self.pages[self.idx][0]
        if name == "confirm":
            self.start_install(); return
        if name == "done":
            self.restart(); return
        self.go(1)

    # ---------- installation ----------
    def start_install(self):
        self.idx = [p[0] for p in self.pages].index("progress"); self.show_page()
        tz = self.tz()
        env = dict(os.environ, JETSON_TARGET=self.target()[0], JETSON_USER=self.e_user.get_text(),
                   JETSON_PASSWORD=self.e_pw1.get_text(), JETSON_HOSTNAME=self.e_host.get_text(),
                   JETSON_TIMEZONE=tz, JETSON_KEYBOARD=self.kb_code(),
                   JETSON_SSH="1" if self.c_ssh.get_active() else "0", JETSON_DEVTOOLS=" ".join(self.devtools()))
        threading.Thread(target=self.run, args=(env,), daemon=True).start()

    STEPS = [("partition layout", .05), ("formatting", .10), ("copying the system", .15), ("account", .85),
             ("boot configuration", .90), ("checking the result", .95), ("developer tools", .96)]

    def run(self, env):
        ok, last = False, ""
        try:
            if FAKE:
                for t, f in [("creating NVIDIA's partition layout", .05), ("formatting", .1), ("copying the system (several minutes)", .15),
                             ("setting up the account and the identity of the new system", .85), ("boot configuration", .9),
                             ("checking the result", .95)]:
                    GLib.idle_add(self.on_line, f"==> {t}"); time.sleep(1.2)
                GLib.idle_add(self.on_line, "INSTALL-COMPLETE"); ok = True
            else:
                p = subprocess.Popen([INSTALLER, "--gui"], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, text=True, bufsize=1)
                for line in p.stdout:
                    last = line.strip() or last
                    GLib.idle_add(self.on_line, line.rstrip("\n"))
                ok = p.wait() == 0
        except Exception as e:
            GLib.idle_add(self.on_line, f"ERROR: {e}")
        GLib.idle_add(self.on_end, ok, last)

    def on_line(self, line):
        buf = self.log.get_buffer(); buf.insert(buf.get_end_iter(), line + "\n")
        self.log.scroll_to_iter(buf.get_end_iter(), 0, False, 0, 0)
        if "[WARNING]" in line or "[skipped]" in line:
            self.notes.append(line.strip())
        if line.startswith("==> "):
            text = line[4:]
            self.pstep.set_text(text[:1].upper() + text[1:])
            for key, frac in self.STEPS:
                if key in text:
                    self.bar.set_fraction(frac)
        return False

    def on_end(self, ok, last):
        self.finished = ok
        self.bar.set_fraction(1.0 if ok else self.bar.get_fraction())
        self.idx = [p[0] for p in self.pages].index("done")
        if ok:
            self.done_msg.set_markup("<b>The system is installed.</b>\n\nRemove the USB stick from the Jetson. "
                                     "Then press Restart. The Jetson starts Debian from the NVMe and asks nothing more."
                                     + ("\n\nNote: " + GLib.markup_escape_text(" ".join(self.notes)) if self.notes else ""))
            self.show_page()
        else:
            self.done_msg.set_text("The install did not finish.\n\n" + last + "\n\nDo not restart. Press Close to get a text console, "
                                   "and tell the developer what the Details said.")
            self.done_msg.get_style_context().add_class("bad")
            self.show_page(); self.next.set_label("Close")
            self.next.get_style_context().remove_class("suggested-action")
        return False

    def restart(self):
        if not self.finished:
            self.rc = 1; Gtk.main_quit(); return
        if FAKE:
            self.done_msg.set_text("(fake mode: the Jetson would restart now)"); return
        try:
            SYSRQ.write("1"); SYSRQ.flush(); TRIGGER.write("b"); TRIGGER.flush()
        except Exception:
            self.done_msg.set_text("Could not restart automatically. Switch the Jetson off and on.")

    def on_close(self, *_):
        # No way out in the middle of an install.
        return self.pages[self.idx][0] == "progress"


if __name__ == "__main__":
    if os.geteuid() != 0 and not FAKE:
        print("run as root (it erases a drive)"); sys.exit(1)
    w = Wizard(); w.show_all(); w.show_page()
    def ready():
        try:
            open(READY, "w").close()      # tells the session script the window is up
        except OSError:
            pass
        return False
    GLib.idle_add(ready)
    Gtk.main()
    sys.exit(w.rc)

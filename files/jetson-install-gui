#!/usr/bin/env python3
"""Graphical installer wizard for Debian on the Jetson Orin Nano.

Asks for the drive, account, host name, location (time zone) and keyboard layout, then runs
/usr/local/sbin/install-to-nvme --gui with those answers in environment variables.
Nothing has a default except what the hardware dictates: the person installing chooses everything.

  jetson-install-gui               full screen, real install (run as root on the USB stick)
  jetson-install-gui --windowed    normal window (development)
  jetson-install-gui --fake        pretend to install (development; changes nothing)
"""
import os, re, subprocess, sys, threading, time

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

FAKE = "--fake" in sys.argv
WINDOWED = "--windowed" in sys.argv
INSTALLER = os.environ.get("JETSON_INSTALLER", "/usr/local/sbin/install-to-nvme")
READY = os.environ.get("JETSON_GUI_READY", "/run/installer-gui-ready")

# Opened now so the restart still works after the USB stick has been pulled.
try:
    SYSRQ = open("/proc/sys/kernel/sysrq", "w")
    TRIGGER = open("/proc/sysrq-trigger", "w")
except OSError:
    SYSRQ = TRIGGER = None

